{
  "name": "effect-prosemirror",
  "version": "0.0.0",
  "private": true,
  "description": "Effect-managed runtime and extension model for ProseMirror.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/Command": {
      "types": "./dist/core/Command.d.ts",
      "default": "./dist/core/Command.js"
    },
    "./core/CommandInvocation": {
      "types": "./dist/core/CommandInvocation.d.ts",
      "default": "./dist/core/CommandInvocation.js"
    },
    "./core/EditingCore": {
      "types": "./dist/core/EditingCore.d.ts",
      "default": "./dist/core/EditingCore.js"
    },
    "./core/Editor": {
      "types": "./dist/core/Editor.d.ts",
      "default": "./dist/core/Editor.js"
    },
    "./core/Error": {
      "types": "./dist/core/Error.d.ts",
      "default": "./dist/core/Error.js"
    },
    "./core/Extension": {
      "types": "./dist/core/Extension.d.ts",
      "default": "./dist/core/Extension.js"
    },
    "./core/InitialContent": {
      "types": "./dist/core/InitialContent.d.ts",
      "default": "./dist/core/InitialContent.js"
    },
    "./core/Key": {
      "types": "./dist/core/Key.d.ts",
      "default": "./dist/core/Key.js"
    },
    "./core/KeyChord": {
      "types": "./dist/core/KeyChord.d.ts",
      "default": "./dist/core/KeyChord.js"
    },
    "./core/Keymap": {
      "types": "./dist/core/Keymap.d.ts",
      "default": "./dist/core/Keymap.js"
    },
    "./core/Priority": {
      "types": "./dist/core/Priority.d.ts",
      "default": "./dist/core/Priority.js"
    },
    "./core/EditorSchema": {
      "types": "./dist/core/EditorSchema.d.ts",
      "default": "./dist/core/EditorSchema.js"
    },
    "./extensions/basic": {
      "types": "./dist/extensions/basic.d.ts",
      "default": "./dist/extensions/basic.js"
    },
    "./extensions/doc": {
      "types": "./dist/extensions/doc.d.ts",
      "default": "./dist/extensions/doc.js"
    },
    "./extensions/paragraph": {
      "types": "./dist/extensions/paragraph.d.ts",
      "default": "./dist/extensions/paragraph.js"
    },
    "./extensions/text": {
      "types": "./dist/extensions/text.d.ts",
      "default": "./dist/extensions/text.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "demo:build": "astro build",
    "demo:dev": "astro dev",
    "demo:preview": "astro preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "mise exec -- pre-commit install --install-hooks",
    "lint": "oxlint --deny-warnings src test vitest.config.ts",
    "lint:fix": "oxlint --fix src test vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "effect": "^3.19.6",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "astro": "^6.4.8",
    "astrobook": "^0.13.2",
    "expect-type": "^1.2.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "packageManager": "pnpm@11.9.0"
}
